# Configure these values in the environment where Spring Boot runs.
# This file is a reference; Spring Boot does not load .env files automatically.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=Imperiumcross-bd;encrypt=true;trustServerCertificate=true
DB_USERNAME=
DB_PASSWORD=
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
